NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINEログイン（LINE Developersコンソールの「LINEログイン」チャネルから取得）
# コールバックURLに {APP_BASE_URL}/api/auth/line/callback を登録すること（ローカル・本番の両方）
LINE_LOGIN_CHANNEL_ID=1234567890
LINE_LOGIN_CHANNEL_SECRET=your-line-channel-secret
# OAuthコールバックURL組み立て用のベースURL（末尾スラッシュなし）
# ローカル: http://localhost:3000 / 本番: VercelのURL
APP_BASE_URL=http://localhost:3000

# Playwright E2E テスト用（管理者アカウント）
TEST_ADMIN_EMAIL=kikiki.4673@gmail.com
TEST_ADMIN_PASSWORD=your-admin-password